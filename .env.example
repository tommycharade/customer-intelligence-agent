OPENROUTER_API_KEY=
# Native Mac UI uses 8765; the separate Docker UI uses 8766.
CIA_DOCKER_PORT=8766
RESEARCH_GATEWAY_PORT=8767
SEARCH_CACHE_TTL=900
PAGE_CACHE_TTL=21600
# Paid search providers are disabled; no Tavily, Exa or Parallel key is needed.
